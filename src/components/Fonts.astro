---
// Google Fonts for the landing and notes pages. A <link> in the head (instead
// of an @import at the top of styles.css) lets the browser fetch the font CSS
// in parallel with the stylesheet instead of only after it has arrived.
const FONTS_URL =
  "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,800;9..144,900&family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={FONTS_URL} />
