---
---
<section class="notes-gate" data-notes-gate>
  <a href="/" class="notes-gate-home">← 返回猪猪山庄</a>
  <div class="notes-gate-card">
    <p class="eyebrow">PIGGY NOTES · 猪猪小记</p>
    <div class="notes-gate-icon" aria-hidden="true">✉</div>
    <h1>我们的小本子</h1>
    <p>一些日常，一些想念。<br />输入密码，打开小记。</p>
    <form>
      <label for="notes-password">小记密码</label>
      <input id="notes-password" type="password" autocomplete="current-password" required maxlength="128" placeholder="输入密码" />
      <button type="submit">解锁小记</button>
    </form>
    <p role="status" aria-live="polite"></p>
  </div>
  <noscript>请启用 JavaScript 后输入密码。</noscript>
</section>
<style is:global>
  [data-notes-content][hidden], [data-notes-gate][hidden] { display: none !important; }
  .notes-gate { min-height: 100svh; padding: 2rem 1.25rem; box-sizing: border-box; background: radial-gradient(ellipse at 20% 20%, #f7dfda, transparent 60%), #faf4eb; color: #513e36; font-family: "Plus Jakarta Sans", system-ui, sans-serif; }
  .notes-gate-home { display: block; max-width: 64rem; margin: auto; color: #69534b; text-decoration: none; }
  .notes-gate-card { max-width: 25rem; margin: max(2rem, 9vh) auto 3rem; padding: 2.4rem 2rem; border-radius: 1.5rem; background: #fffaf4; border: 1px solid #e6d5cb; box-shadow: 0 18px 70px #72513b12; text-align: center; }
  .notes-gate-card .eyebrow { font-size: .72rem; letter-spacing: .14em; color: #956b60; }
  .notes-gate-icon { font-size: 2.7rem; margin: 1.25rem; color: #ba8579; }
  .notes-gate-card h1 { font-size: 1.8rem; margin: .6rem 0; }
  .notes-gate-card p { line-height: 1.8; }
  .notes-gate form { text-align: left; margin-top: 1.8rem; }
  .notes-gate label { display: block; font-size: .85rem; margin-bottom: .55rem; }
  .notes-gate input { width: 100%; box-sizing: border-box; font: inherit; padding: .9rem; border: 1px solid #cbb4a7; border-radius: .7rem; background: white; color: #513e36; }
  .notes-gate button { width: 100%; margin-top: .9rem; padding: .9rem; border: 0; border-radius: .7rem; font: inherit; color: white; background: #805d52; cursor: pointer; }
  .notes-gate button:disabled { opacity: .6; }
  .notes-gate input:focus-visible, .notes-gate button:focus-visible { outline: 3px solid #c99372; outline-offset: 3px; }
  .notes-gate [role=status] { font-size: .85rem; color: #8e4539; }
  .notes-lock-bar { max-width: 70rem; margin: 1rem auto; padding: 0 1.5rem; text-align: right; }
  .notes-lock-bar button { border: 1px solid #cbb4a7; border-radius: 2rem; background: #fffaf4; color: #513e36; padding: .65rem 1rem; font: inherit; cursor: pointer; }
</style>

