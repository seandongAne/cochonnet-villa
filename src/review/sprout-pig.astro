---
import SeoHead from '../components/SeoHead.astro';
import SproutPigPreview from '../little-universe/SproutPigPreview.jsx';
import '../viewport-scale.css';
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead title="发芽小猪 · 3D 样板" description="对照选定形象，查看发芽小猪的第一版三维样板。" path="/little-universe/sprout-pig/" locale="zh_CN" noindex /></head>
<body><main>
  <header><a href="/little-universe/characters/">← 猪菜形象册</a><p class="eyebrow">LITTLE SPROUT · SCULPT STUDY 01</p><h1>小猪，转个身。</h1><p>先看这一只。圆脸、垂耳、歪头笑，还有头顶的小嫩芽。</p></header>
  <div class="comparison"><figure><img src="/birthday-characters/sprout-pig-v1.webp" width="1200" height="1200" alt="已选定的浅蜜桃色发芽小猪原图，作为模型对照" /><figcaption>已选定的形象</figcaption></figure><div><SproutPigPreview client:only="react" /><p class="caption">3D 样板 · 待你验收</p></div></div>
  <footer><p>可以查看两侧和背面。背部、卷尾巴是本次补充的造型，尚待确认。</p><p>这一版先核对比例与表情；黏土的细微纹理还没有加入。</p><a href="/birthday-characters/sprout-pig-study-v1.glb" download>下载 3D 模型（GLB）</a></footer>
</main></body>
</html>
<style is:global>
body { margin: 0; color: #665246; background: #fbf6ed; font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif; }
main { max-width: 1200px; margin: auto; padding: 24px 28px 36px; }
header, footer { text-align: center; } a { color: #85745d; text-underline-offset: 4px; font-size: .8rem; }
.eyebrow { font-size: .65rem; letter-spacing: .22em; color: #9e8b70; margin: 25px 0 12px; }
h1 { font: normal clamp(1.9rem, 4vw, 2.8rem)/1.3 Georgia, 'Microsoft YaHei', serif; margin: 0 0 12px; }
header > p:last-child { font-size: .86rem; color: #9c8872; margin-bottom: 25px; }
.comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
figure { margin: 0; } figure img { display: block; width: 100%; height: auto; border-radius: 22px; }
figcaption, .caption { text-align: center; font-size: .8rem; color: #9b8169; margin: 14px 0 0; }
.study-canvas { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 22px; background: #f5ecdf; }
.study-canvas > div:first-child { position: absolute !important; inset: 0; }
.study-canvas canvas { touch-action: none; }
.study-status { position: absolute; top: 45%; left: 0; right: 0; text-align: center; pointer-events: none; }
.study-viewer nav { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; margin-top: 13px; }
.study-viewer button { border: 1px solid #e0d5c6; border-radius: 18px; background: transparent; color: #88745d; padding: 7px 13px; cursor: pointer; font: inherit; font-size: .75rem; }
.study-viewer button[aria-pressed=true] { background: #e6e9d7; color: #526042; border-color: #b9c4a2; }
.study-hint { text-align: center; color: #a59077; font-size: .7rem; margin: 9px 0 0; }
footer { margin-top: 28px; font-size: .76rem; color: #a18b74; line-height: 1.8; }
button:focus-visible, a:focus-visible { outline: 3px solid #9aac60; outline-offset: 3px; }
@media (max-width: 640px) { main { padding: 20px 16px 30px; } .comparison { grid-template-columns: 1fr; gap: 24px; } header > p:last-child { line-height: 1.8; } }
</style>
