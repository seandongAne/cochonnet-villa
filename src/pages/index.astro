---
import site from "../../content/site.json";
import "../viewport-scale.css";
import "../styles.css";
import "../entry-greeting.css";
import SeoHead from "../components/SeoHead.astro";
import Fonts from "../components/Fonts.astro";
import { renderSite } from "../render-site.js";
import { websiteJsonLd } from "../seo.js";

const title = site?.seo?.title || "Cochonnet Villa";
const description = site?.seo?.description || "";
const appHtml = renderSite(site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      path="/"
      locale="en_US"
      localeAlternate={["zh_CN"]}
      jsonLd={[websiteJsonLd({ site: Astro.site, description })]}
    />
    <meta name="theme-color" content="#f8c2ba" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <Fonts />
  </head>
  <body>
    <Fragment set:html={appHtml} />
    <script>
      import { mountPortraitDecor } from '../portrait-decor.js';
      import { createEntryGreeting } from '../entry-greeting.js';
      const environment = { root: document.documentElement, location: window.location, window, document };
      const greeting = createEntryGreeting(environment);
      mountPortraitDecor({ ...environment, onChange: greeting.setActive });

      const artworkDialog = document.querySelector<HTMLDialogElement>('#villa-artwork-viewer');
      const artworkOpen = document.querySelector<HTMLButtonElement>('[data-artwork-open]');
      const artworkClose = document.querySelector<HTMLButtonElement>('[data-artwork-close]');
      const artworkZoom = document.querySelector<HTMLButtonElement>('[data-artwork-zoom]');
      const artworkCanvas = document.querySelector<HTMLElement>('.artwork-viewer-canvas');
      let previousOverflow = '';
      artworkOpen?.addEventListener('click', () => {
        if (!artworkDialog || artworkDialog.open) return;
        previousOverflow = document.body.style.overflow;
        artworkDialog.showModal();
        document.body.style.overflow = 'hidden';
      });
      artworkClose?.addEventListener('click', () => artworkDialog?.close());
      artworkZoom?.addEventListener('click', () => {
        const zoomed = artworkCanvas?.classList.toggle('is-zoomed') ?? false;
        artworkZoom.setAttribute('aria-pressed', String(zoomed));
      });
      artworkDialog?.addEventListener('close', () => {
        document.body.style.overflow = previousOverflow;
        artworkCanvas?.classList.remove('is-zoomed');
        artworkCanvas?.scrollTo(0, 0);
        artworkZoom?.setAttribute('aria-pressed', 'false');
        artworkOpen?.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
