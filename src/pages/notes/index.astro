---
import notesData from "../../../content/notes.json";
import "../../styles.css";
import { normalizeNotes, renderNotesPage } from "../../render-notes.js";

const notes = normalizeNotes(notesData);
const pageHtml = renderNotesPage(notes);
const title = "猪猪小记 | 猪猪山庄";
const description = "猪猪山庄的随笔小本子：日常、小猪们的新鲜事，和一些突然想说的话。";
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8c2ba" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <Fragment set:html={pageHtml} />
  </body>
</html>
