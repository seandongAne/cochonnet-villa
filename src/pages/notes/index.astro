---
import notesData from "../../../content/notes.json";
import "../../viewport-scale.css";
import NotesAccess from "../../components/NotesAccess.astro";
import NotesLock from "../../components/NotesLock.astro";
import "../../styles.css";
import SeoHead from "../../components/SeoHead.astro";
import Fonts from "../../components/Fonts.astro";
import { normalizeNotes, renderNotesPage } from "../../render-notes.js";
import { NOTES_TITLE } from "../../seo.js";

const notes = normalizeNotes(notesData);
const pageHtml = renderNotesPage(notes);
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={NOTES_TITLE} description="输入密码，打开我们的小本子。" path="/notes/" noindex />
    <meta name="theme-color" content="#f8c2ba" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <Fonts />
  </head>
  <body data-notes-title="猪猪小记 | Cochonnet Villa">
    <NotesAccess />
    <div data-notes-content hidden>
    <NotesLock />
    <Fragment set:html={pageHtml} />
    </div>
  </body>
</html>

<script>
  import { initNotesAccess } from "../../notes-access.js";
  initNotesAccess();
</script>
