---
import notesData from "../../../content/notes.json";
import "../../viewport-scale.css";
import "../../styles.css";
import SeoHead from "../../components/SeoHead.astro";
import { normalizeNotes, renderNotesPage } from "../../render-notes.js";
import { NOTES_DESCRIPTION, NOTES_TITLE, blogJsonLd, breadcrumbJsonLd } from "../../seo.js";

const notes = normalizeNotes(notesData);
const pageHtml = renderNotesPage(notes);
const site = Astro.site;
const jsonLd = [
  blogJsonLd(notes, { site }),
  breadcrumbJsonLd(
    [
      { name: "猪猪山庄", path: "/" },
      { name: "猪猪小记", path: "/notes/" }
    ],
    { site }
  )
];
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={NOTES_TITLE} description={NOTES_DESCRIPTION} path="/notes/" jsonLd={jsonLd} />
    <meta name="theme-color" content="#f8c2ba" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <Fragment set:html={pageHtml} />
  </body>
</html>
