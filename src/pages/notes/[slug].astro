---
import notesData from "../../../content/notes.json";
import "../../viewport-scale.css";
import NotesAccess from "../../components/NotesAccess.astro";
import NotesLock from "../../components/NotesLock.astro";
import "../../styles.css";
import SeoHead from "../../components/SeoHead.astro";
import Fonts from "../../components/Fonts.astro";
import { normalizeNotes, renderNotePage } from "../../render-notes.js";
import { notePath } from "../../seo.js";

export function getStaticPaths() {
  const notes = normalizeNotes(notesData);

  return notes.map((note, index) => ({
    params: { slug: note.slug },
    props: {
      note,
      previousNote: notes[index - 1] ?? null,
      nextNote: notes[index + 1] ?? null
    }
  }));
}

const { note, previousNote, nextNote } = Astro.props;
const pageHtml = renderNotePage(note, { previousNote, nextNote });
const path = notePath(note);
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title="猪猪小记 | Cochonnet Villa"
      description="输入密码，打开我们的小本子。"
      path={path}
      noindex
    />
    <meta name="theme-color" content="#f8c2ba" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <Fonts />
  </head>
  <body data-notes-title="猪猪小记 | Cochonnet Villa">
    <NotesAccess />
    <div data-notes-content hidden>
    <NotesLock />
    <Fragment set:html={pageHtml} />
    </div>
  </body>
</html>

<script>
  import { initNotesAccess } from "../../notes-access.js";
  initNotesAccess();
</script>
