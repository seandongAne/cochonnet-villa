---
import notesData from "../../../content/notes.json";
import "../../viewport-scale.css";
import "../../styles.css";
import SeoHead from "../../components/SeoHead.astro";
import Fonts from "../../components/Fonts.astro";
import { normalizeNotes, renderNotePage, noteExcerpt } from "../../render-notes.js";
import { blogPostingJsonLd, breadcrumbJsonLd, noteDateTime, notePath, noteShareImage } from "../../seo.js";

export function getStaticPaths() {
  const notes = normalizeNotes(notesData);

  return notes.map((note, index) => ({
    params: { slug: note.slug },
    props: {
      note,
      previousNote: notes[index - 1] ?? null,
      nextNote: notes[index + 1] ?? null
    }
  }));
}

const { note, previousNote, nextNote } = Astro.props;
const pageHtml = renderNotePage(note, { previousNote, nextNote });
const title = `${note.title} | 猪猪小记`;
const description = noteExcerpt(note.body, 90);
const site = Astro.site;
const path = notePath(note);
const jsonLd = [
  blogPostingJsonLd(note, { site }),
  breadcrumbJsonLd(
    [
      { name: "猪猪山庄", path: "/" },
      { name: "猪猪小记", path: "/notes/" },
      { name: note.title, path }
    ],
    { site }
  )
];
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      path={path}
      type="article"
      image={noteShareImage(note, site)}
      publishedTime={noteDateTime(note.date) || undefined}
      jsonLd={jsonLd}
    />
    <meta name="theme-color" content="#f8c2ba" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <Fonts />
  </head>
  <body>
    <Fragment set:html={pageHtml} />
  </body>
</html>
